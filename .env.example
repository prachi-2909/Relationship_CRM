# Copy to .env at the repo root to override docker-compose defaults.
# This is separate from backend/.env, which is only used for local
# (non-Docker) `uvicorn` runs.

# Always change this before deploying anywhere reachable.
SECRET_KEY=dev-insecure-change-me

# Browser origins allowed to call the API (JSON list). The bundled web UI is served same-origin by
# nginx, so the default is enough unless another site calls the API. Example for a real domain:
# CORS_ORIGINS=["https://crm.example.com"]

# The session cookie defaults to Secure (HTTPS-only) even in this HTTP-only
# compose stack - login won't persist until you put a TLS-terminating proxy
# in front (http://localhost is exempted by browsers, so local use is fine
# as-is). Only set this to false for an isolated, trusted network with no TLS.
# SESSION_COOKIE_SECURE=false

# Optional: point at any OpenAI-compatible endpoint. Left unset, the app
# runs its deterministic offline stub for extraction/drafting/the agent.
LLM_BASE_URL=
LLM_MODEL=stub
LLM_API_KEY=
# LLM_PROVIDER=openai          # or "anthropic" for the Anthropic API (then LLM_BASE_URL=https://api.anthropic.com)
# LLM_TIMEOUT_SECONDS=120

# --- Shared-server deployment (behind a host Nginx under a sub-path) ---
# Free host port for the frontend container; it binds to 127.0.0.1 only. Find a free one with
#   sudo ss -lntp
# and never reuse a port another app is using. Required by docker-compose.yml.
CRM_HOST_PORT=

# Public sub-path the app is served under. MUST start and end with "/" (use "/" for a root deployment).
# It sets the web app's base path and scopes the session cookie to it.
PUBLIC_BASE_PATH=/sbi-relationship-crm/

# Who places an outgoing call: "android_native" (the app dials through the phone's SIM; the default here) or
# "knowlarity" (the server triggers Knowlarity click-to-call).
# TELEPHONY_PROVIDER=android_native

# Transcription tuning (defaults are in docker-compose.yml: English, no seed prompt, small model).
# TRANSCRIPTION_LANGUAGE=en
# TRANSCRIPTION_PROMPT=
# TRANSCRIPTION_MODEL=Systran/faster-whisper-small

# Seconds allowed for one transcription request (CPU Whisper runs about real-time).
# TRANSCRIPTION_TIMEOUT_SECONDS=900
