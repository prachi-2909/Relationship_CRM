<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Sideload self-update: lets the system installer accept the APK this app hands it via
         FileProvider. Does not itself request the "install unknown apps" toggle - the DC grants
         that once via Settings the same way they did for the initial sideload. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android-native (SIM) calling: places the call directly via ACTION_CALL and observes
         its state for the duration of the call. No recording is ever attempted (see
         services/telephony/native_provider.py on the backend) - these exist only to dial and
         to time the call, not to capture audio. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Call auto-detection: without it Android may skip screening callbacks for numbers saved
         in the phone's contacts (e.g. an official the DC has saved). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- To confirm from the call log whether a call was actually answered, so missed/rejected calls
         are never logged into the CRM or recorded. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Since targetSdk 34, the generic FOREGROUND_SERVICE permission above is not enough -
         every foreground-service type needs its own matching FOREGROUND_SERVICE_<TYPE>
         permission too, or startForeground() throws SecurityException at runtime (confirmed
         on-device: "requires permissions: ... [FOREGROUND_SERVICE_DATA_SYNC]"). Must match
         the type declared on the <service> below and in NativeCallForegroundService.kt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Mic experiment: lets the call-tracking service keep recording while the dialer is in
         front. Only requested at runtime when RECORD_AUDIO is also granted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Android 13+ requires this to show ANY notification, including the foreground
         service's own "Call in progress" one - without it, startForeground() still works
         but the notification is silently suppressed, not an error. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Shizuku: one privilege source for the two-sided call recorder (ported from CallVault). Only
         ever granted when the DC has Shizuku installed and allows it; otherwise it is never held. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Built-in (embedded-ADB) mode: the recorder daemon, running as the shell user, grants this to
         the app so it can keep Wireless Debugging armed. Never held by the app on its own. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: without this Shizuku looks uninstalled even when running. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".RcrmApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Rcrm"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Rcrm"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku's client-side provider: how the Shizuku API receives its binder in our process
             (for the ported two-sided call recorder). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Built-in (embedded-ADB) mode: receives the shell-uid recorder daemon's binder. exported
             is required because that daemon is a non-app process (mirrors Shizuku's own provider);
             only "sendBinder" is honoured, and no app data is exposed. -->
        <provider
            android:name=".recorder.RecorderBinderProvider"
            android:authorities="${applicationId}.recorder.binder"
            android:enabled="true"
            android:exported="true" />

        <!-- Survives OEM aggressive background-process killing (Xiaomi/Realme/Samsung)
             for the duration of a native-SIM call - a plain ViewModel-scoped listener would
             not. Deliberately NOT foregroundServiceType="phoneCall": since Android 14 that
             type is gated to apps registered as a Telecom ConnectionService (full default-
             dialer-style integration), which this app isn't - starting it without that
             throws immediately, before the service ever posts its notification. dataSync
             carries no such eligibility requirement beyond the base FOREGROUND_SERVICE
             permission, which is all this service actually needs. -->
        <service
            android:name=".nativecall.NativeCallForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />

        <!-- Call auto-detection. The receiver learns when any call starts/connects/ends; the
             screening service (only active once the DC grants the call-screening role from the
             Profile screen) supplies the number. Neither alters or blocks a call. PHONE_STATE
             is a protected broadcast only the system can send, so exported="true" is safe. -->
        <receiver
            android:name=".calldetect.PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".calldetect.CrmCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Built-in (embedded-ADB) pairing: discovers the Wireless Debugging pairing port and takes
             the 6-digit code via an inline notification reply. -->
        <service
            android:name=".recorder.AdbPairingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Records an answered call that wasn't placed from the app's Call button (incoming, or a
             dialer-placed call). CRM-gated; discards if not a CRM number or not answered. -->
        <service
            android:name=".calldetect.CallRecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />

    </application>

</manifest>
