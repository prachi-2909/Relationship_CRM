<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The actual Material 3 color scheme is applied
         in Compose via ui.theme.RcrmTheme; this XML theme only needs to exist
         so the manifest / window can reference something before Compose content is set. -->
    <style name="Theme.Rcrm" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F5F3F0</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowBackground">#F5F3F0</item>
    </style>
</resources>
