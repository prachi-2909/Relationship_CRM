.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.env
.env.*
!.env.example
# Databases, backups, uploaded call media and release APKs must NEVER be baked into the image
# (they hold officials' PII, password hashes and call audio). ** matches at any depth, unlike *.db.
*.db
**/*.db
*.db-journal
*.db-wal
*.db-shm
backups/
**/backups/
media/
**/media/
releases/
**/releases/
tests/
.git/
