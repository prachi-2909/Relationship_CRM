# Copy to .env and adjust. .env is git-ignored.

ENVIRONMENT=development

# SQLite for now. For Postgres:
#   DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/relationship_crm
DATABASE_URL=sqlite+pysqlite:///./relationship_crm.db

# Signed-cookie / session settings
SESSION_COOKIE_NAME=rcrm_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Comma-free JSON list; the frontend dev server origin
CORS_ORIGINS=["http://localhost:5173"]

# Change for any non-local deployment
SECRET_KEY=dev-insecure-change-me

# --- AI data processing (DPDP) ---------------------------------------------
# Master switch. false = send NOTHING to any AI endpoint (transcription, LLM,
# embeddings all fall back to offline stubs), whatever the URLs below say.
AI_DATA_PROCESSING_ENABLED=true
#
# IMPORTANT (DPDP Act): call audio and transcripts are personal data. For
# production, these endpoints MUST be self-hosted inside India so nothing
# crosses the border - see deploy/self-hosted-ai/README.md. A hosted US
# provider (e.g. Groq below) is for local dev/testing ONLY, never production.

# --- Transcription (speech-to-text) ----------------------------------------
# OpenAI-compatible /audio/transcriptions. Empty = offline (manual-text recap).
# Self-hosted (production): point at the Speaches/faster-whisper service.
# TRANSCRIPTION_BASE_URL=http://<ai-host>:8001/v1
# TRANSCRIPTION_MODEL=Systran/faster-whisper-large-v3

# --- LLM -------------------------------------------------------------------
# With no LLM_BASE_URL the app runs a deterministic offline stub (fine for
# tests and demos). Point these at any OpenAI-compatible chat endpoint.
# After changing, verify with:  python -m app.scripts.check_llm
#
# Self-hosted (production, DPDP): vLLM serving an Indic open-weights model.
# LLM_BASE_URL=http://<ai-host>:8002/v1
# LLM_MODEL=sarvamai/sarvam-m
# LLM_TIMEOUT_SECONDS=120
#
# Groq (hosted US — DEV/TEST ONLY, do not use in production; crosses the border):
#   key at https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant        # or llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
# LLM_TIMEOUT_SECONDS=60
#
# Local Ollama (needs ~6 GB free RAM for an 8B model; no key):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_TIMEOUT_SECONDS=120

# ---- Inbound CRM API key (reserved) -------------------------------------
# A stable key to let another agent/service connect to this CRM later. Put the
# real value only in .env (gitignored). No endpoint consumes it yet.
# CRM_API_KEY=rcrm_...

# ---- Eko Gmail Template Sender (MCP) ------------------------------------
# Shared API key for sending CSP birthday wishes. Ask whoever shared the Gmail
# skill for the real value; put it only in .env (never here).
# GMAIL_MCP_API_KEY=
