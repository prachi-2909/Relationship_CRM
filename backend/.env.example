# Copy to .env and adjust. .env is git-ignored.

ENVIRONMENT=development

# SQLite for now. For Postgres:
#   DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/relationship_crm
DATABASE_URL=sqlite+pysqlite:///./relationship_crm.db

# Signed-cookie / session settings
SESSION_COOKIE_NAME=rcrm_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Comma-free JSON list; the frontend dev server origin
CORS_ORIGINS=["http://localhost:5173"]

# Change for any non-local deployment
SECRET_KEY=dev-insecure-change-me

# --- LLM -------------------------------------------------------------------
# With no LLM_BASE_URL the app runs a deterministic offline stub (fine for
# tests and demos). Point these at any OpenAI-compatible chat endpoint.
# After changing, verify with:  python -m app.scripts.check_llm
#
# Groq (hosted, free tier, fast — recommended; no local RAM cost):
#   key at https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant        # or llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
# LLM_TIMEOUT_SECONDS=60
#
# Local Ollama (needs ~6 GB free RAM for an 8B model; no key):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_TIMEOUT_SECONDS=120
