# Copy to .env and adjust. .env is git-ignored.

ENVIRONMENT=development

# SQLite for now. For Postgres:
#   DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/relationship_crm
DATABASE_URL=sqlite+pysqlite:///./relationship_crm.db

# Signed-cookie / session settings
SESSION_COOKIE_NAME=rcrm_session
SESSION_TTL_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Comma-free JSON list; the frontend dev server origin
CORS_ORIGINS=["http://localhost:5173"]

# Change for any non-local deployment
SECRET_KEY=dev-insecure-change-me
